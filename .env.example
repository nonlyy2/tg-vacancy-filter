# --- Telegram credentials ---
# Get these from https://my.telegram.org -> API Development Tools
TG_APP_ID=1234567
TG_APP_HASH=abcdef1234567890abcdef1234567890

# Phone number in international format (the account that acts as the userbot)
TG_PHONE=+77001234567

# --- Session (pick ONE; this is what makes unattended runs possible) ---
# 1. Telethon StringSession — recommended for CI / servers with no terminal.
#    Generate once locally, then store it as a secret. Must be created with the
#    SAME TG_APP_ID as above.
TG_STRING_SESSION=

# 2. Local session file. Created automatically on the first interactive run.
SESSION_PATH=session.json

# 3. Base64 of an existing session.json, materialised at SESSION_PATH on boot.
#    An existing file always wins over this.
TG_SESSION_BASE64=

# --- Channels to monitor ---
# Comma-separated list of channel IDs (either "-100xxxxxxxxxx" or the raw id).
# To find an id: forward a post from the channel to @userinfobot, or use @getidsbot.
# The account must already be a member of every channel listed here.
SOURCE_CHANNEL_IDS=-1001111111111,-1002222222222

# Where matches are delivered. Allowed values:
#   me                              -> Saved Messages of the userbot account
#   <username>                      -> any user/channel the account can reach (no @)
#   -1001234567890                  -> channel by numeric id; use this for a
#                                      private channel you created yourself,
#                                      which has no username to resolve
#   https://t.me/+AbCdEf123         -> private channel invite link (auto-joins)
#   https://t.me/joinchat/AbCdEf123 -> legacy invite link form
DESTINATION=me

# --- Candidate profile ---
# Markdown file describing who the vacancies are for. Injected into the prompt,
# so retuning the filter is an edit to this file, not a code change.
PROFILE_PATH=profile/candidate.md

# Minimum score (0-100) a post must reach to be forwarded. Posts the model
# marks as onsite or hybrid are rejected regardless of score.
MATCH_THRESHOLD=65

# --- Gemini ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...

# Primary model. Gemini-family models enforce the response schema server-side,
# which is what keeps verdicts parseable. Run `./bot -doctor` to see which
# models your key actually serves — the free-tier lineup changes often.
GEMINI_MODEL=gemini-2.5-flash-lite

# Used for the rest of a run once the primary model's daily quota is spent.
# Gemma's free-tier RPD is roughly 10x higher, which is what lets a long
# backlog finish. Set empty to disable the switch.
GEMINI_MODEL_FALLBACK=gemma-4-26b-a4b-it

# Client-side request ceiling. 0 disables throttling (paid tier).
GEMINI_RPM=12

# --- Polling (./bot -once) ---
# Cursor + seen-post fingerprints. Keep this on a persistent volume, or let the
# scheduled workflow commit it back to the repo.
POLL_STATE_PATH=state.json

# The first time a channel is polled it has no cursor. This date decides how
# far back that first sweep reaches (YYYY-MM-DD, UTC). Leave empty to start
# from the moment of the first run.
POLL_BOOTSTRAP_SINCE=2026-08-24

# Budget for a single -once run. On expiry the cursor is saved and the process
# exits cleanly, so a long backlog is consumed across several scheduled runs.
POLL_MAX_RUNTIME=18m

# --- Live mode (./bot with no flags) ---
# Ignore live updates older than this many seconds, so a burst of missed
# updates after a reconnect is not re-processed. 0 disables the check.
MAX_MESSAGE_AGE_SECONDS=900

# --- Logging ---
# Every match is appended here as one JSON object per line. Contains the text
# of source posts — keep it out of public repositories. Empty disables it.
MATCH_LOG_PATH=matches.jsonl

# debug | info | warn | error
LOG_LEVEL=info
